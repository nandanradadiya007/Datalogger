<Window x:Class="PressureDataLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PressureDataLogger"
        mc:Ignorable="d"
        Title="Pressure Data Logger - NI-DAQmx" Height="600" Width="900"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="NI-DAQmx Pressure Data Logger" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Configuration Panel -->
        <GroupBox Grid.Row="1" Header="DAQ Configuration" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device/Channel -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Device/Channel:" 
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDeviceChannel" 
                         Text="Dev1/ai0" VerticalAlignment="Center" Margin="5" Padding="5"/>

                <!-- Sample Rate -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Sample Rate (Hz):" 
                           VerticalAlignment="Center" Margin="10,5,0,5"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtSampleRate" 
                         Text="1000" VerticalAlignment="Center" Margin="5" Padding="5"/>

                <!-- Samples Per Read -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Samples Per Read:" 
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSamplesPerRead" 
                         Text="100" VerticalAlignment="Center" Margin="5" Padding="5"/>

                <!-- Control Buttons -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" 
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnStart" Content="Start Acquisition" 
                            Width="120" Height="30" Margin="0,0,10,0" 
                            Click="BtnStart_Click" Background="#FF4CAF50" Foreground="White"/>
                    <Button x:Name="btnStop" Content="Stop Acquisition" 
                            Width="120" Height="30" Margin="0,0,10,0" 
                            Click="BtnStop_Click" IsEnabled="False" Background="#FFF44336" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Logging Panel -->
        <GroupBox Grid.Row="2" Header="CSV Logging" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Log File Path -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Log File Path:" 
                           VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLogFilePath" 
                         Text="" IsReadOnly="True" VerticalAlignment="Center" 
                         Margin="5" Padding="5" Background="#FFF5F5F5"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="btnBrowse" 
                        Content="Browse..." Width="80" Height="25" 
                        Margin="5" Click="BtnBrowse_Click"/>

                <!-- Logging Control -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnStartLogging" Content="Start Logging" 
                            Width="120" Height="30" Margin="0,0,10,0" 
                            Click="BtnStartLogging_Click" Background="#FF2196F3" Foreground="White"/>
                    <Button x:Name="btnStopLogging" Content="Stop Logging" 
                            Width="120" Height="30" 
                            Click="BtnStopLogging_Click" IsEnabled="False" Background="#FFFF9800" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Data Display Panel -->
        <GroupBox Grid.Row="3" Header="Data Display" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Latest Value -->
                <Border Grid.Row="0" BorderBrush="#FF2196F3" BorderThickness="2" 
                        Background="#FFF0F8FF" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Latest Value:" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="txtLatestValue" Text="-- V" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="#FF2196F3" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Recent Samples List -->
                <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <ListBox x:Name="lstRecentSamples" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="4" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" 
                Background="#FFF5F5F5" Padding="10,5">
            <TextBlock x:Name="txtStatus" Text="Ready" FontSize="12"/>
        </Border>
    </Grid>
</Window>
