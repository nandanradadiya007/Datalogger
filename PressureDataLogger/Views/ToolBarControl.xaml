<UserControl x:Class="PressureDataLogger.Views.ToolBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <ToolBar x:Name="mainToolbar">
        <Button Content="New" Click="ButtonNew_Click" ToolTip="New Session"/>
        <Button Content="Open" Click="ButtonOpen_Click" ToolTip="Open Session"/>
        <Button Content="Save" Click="ButtonSave_Click" ToolTip="Save Session"/>
        <Separator/>
        <Button Content="Dashboard" Click="ButtonDashboard_Click" ToolTip="Show Dashboard"/>
        <Button Content="Graphs" Click="ButtonGraphs_Click" ToolTip="Show Graphs"/>
        <Button Content="Calibration" Click="ButtonCalibration_Click" ToolTip="Open Calibration"/>
        <Separator/>
        <Button Content="Start Acquisition" Click="ButtonStartAll_Click" Background="#FF4CAF50" Foreground="White" Padding="10,5" FontWeight="Bold"/>
        <Button Content="Stop Acquisition" Click="ButtonStopAll_Click" Background="#FFF44336" Foreground="White" Padding="10,5" FontWeight="Bold"/>
    </ToolBar>
</UserControl>
