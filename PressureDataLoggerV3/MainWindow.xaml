<Window x:Class="PressureDataLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PressureDataLogger"
        xmlns:views="clr-namespace:PressureDataLogger.Views"
        mc:Ignorable="d"
        Title="Lab Data Acquisition System V3 - Modular Component Architecture" Height="700" Width="1100"
        Closing="Window_Closing">
    <DockPanel>
        <!-- Menu Bar Component -->
        <views:MenuBarControl x:Name="menuBar" DockPanel.Dock="Top"/>

        <!-- Toolbar Component -->
        <views:ToolBarControl x:Name="toolBar" DockPanel.Dock="Top"/>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Lab Data Acquisition System" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="1" Grid.RowSpan="3" x:Name="mainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" x:Name="tabDashboard">
                <views:DashboardControl x:Name="dashboardControl"/>
            </TabItem>

            <!-- Graphs Tab -->
            <TabItem Header="Graphs" x:Name="tabGraphs">
                <views:GraphsControl x:Name="graphsControl"/>
            </TabItem>

            <!-- Data Table Tab -->
            <TabItem Header="Data Table" x:Name="tabDataTable">
                <views:DataTableControl x:Name="dataTableControl"/>
            </TabItem>

            <!-- Calibrations Tab -->
            <TabItem Header="Calibrations" x:Name="tabCalibrations">
                <views:CalibrationsControl x:Name="calibrationsControl"/>
            </TabItem>

            <!-- CSV Logging Tab -->
            <TabItem Header="CSV Logging" x:Name="tabLogging">
                <views:CsvLoggingControl x:Name="csvLoggingControl"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="4" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" 
                Background="#FFF5F5F5" Padding="10,5">
            <TextBlock x:Name="txtStatus" Text="Ready" FontSize="12"/>
        </Border>
    </Grid>
    </DockPanel>
</Window>
