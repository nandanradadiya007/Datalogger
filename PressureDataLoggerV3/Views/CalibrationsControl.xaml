<UserControl x:Class="PressureDataLogger.Views.CalibrationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="New Calibration" Click="ButtonNewCalibration_Click" Width="130" Margin="0,0,10,0"/>
            <Button Content="Load Calibration" Click="ButtonLoadCalibration_Click" Width="130" Margin="0,0,10,0"/>
            <Button Content="Save Calibration" Click="ButtonSaveCalibration_Click" Width="130"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Active Calibrations">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlCalibrations">
                    <TextBlock Text="No calibrations loaded" FontStyle="Italic" Foreground="Gray" Margin="10"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
